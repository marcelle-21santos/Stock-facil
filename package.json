{
  "name": "stock-facil",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema desktop local de controle de produtos, estoque, vendas e operações comerciais",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "admin:setup-recovery": "electron scripts/setup-admin-recovery.cjs",
    "postinstall": "electron-builder install-app-deps",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "electron-updater": "^6.6.2",
    "exceljs": "^3.4.0",
    "lucide-react": "^0.468.0",
    "pdfkit": "^0.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.13.8",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.0",
    "sass": "^1.89.0",
    "typescript": "^5.8.3",
    "vitest": "^5.1.1"
  },
  "build": {
    "appId": "br.com.stockfacil.desktop",
    "productName": "Stock Fácil",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
